---
const menu = [
  ['Dashboard', 'M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z'],
  ['Account', 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zm-12 14v-2a8 8 0 0 1 16 0v2'],
  ['Documents', 'M5 2h9l5 6v14H5zM14 2v7h5'],
  ['Payment History', 'M2 5h20v14H2zM2 10h20'],
  ['Internet Usage', 'M3 21V8m6 13V3m6 18V11m6 10V6'],
  ['Office Locations', 'M4 21h16M6 21V3h10v18m-7-14h4m-4 4h4'],
  ['Refer offer', 'M3 9h18v4H3zm2 4v8h14v-8M12 9v12M12 9C3 9 5 0 9 4zM12 9c9 0 7-9 3-5z'],
  ['Support', 'M3 14v-3a9 9 0 0 1 18 0v5h-4v-6h4M3 10h4v6H3z'],
  ['FAQs', 'M2 3h20v14H9l-6 5v-5H2z'],
  ['Contact Us', 'M2 4h20v16H2zM2 5l10 8L22 5']
];
const bars = [[29,14],[48,29],[48,35],[75,25],[100,64],[76,32],[62,31]];
const usage = [['Download','30.86 GB'],['Upload','1.24 GB'],['Duration','80 hrs'],['Total','32.10 GB']];
const plan = [['Renew date','Aug 6, 2021'],['Expiry date','Sep 6, 2021'],['Download','50 Mbps'],['Upload','40 Mbps']];
---
<div class="dashboard" role="img" aria-label="Web Networks customer dashboard showing internet usage, 12 days remaining on the plan, account status and subscription details.">
  <div class="dashboard-ui" aria-hidden="true">
    <div class="brandbar"><img src="/images/web-networks-portal-logo.png" width="32" height="25" alt="Web Networks logo" draggable="false"/></div>
    <div class="workspace">
      <div class="sidebar">
        {menu.map(([label, path]) => <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d={path}/></svg>{label}</div>)}
      </div>
      <div class="panels">
        <div class="usage panel">
          <b>Internet Usage</b>
          <div class="bars">{bars.map(([down,up]) => <span><i style={`height:${down}%`}></i><i style={`height:${up}%`}></i></span>)}</div>
          <div class="stats">{usage.map(([name,value]) => <span><strong>{name}</strong>{value}</span>)}</div>
        </div>
        <div class="remaining panel"><b>Remaining Days</b><div class="days"><span>12 days remaining<br/>out of 30 days</span><i>12</i></div><strong>Pay advance</strong></div>
        <div class="status panel"><b>Account Status</b><div><span><strong>51200/40960</strong><small>(down/up) kbps</small></span><span class="online"><i></i>online</span></div></div>
        <div class="subscription panel"><b>Internet subscription</b><div>{plan.map(([label,value],i) => <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={i < 2 ? 'M3 6h18v15H3zM3 10h18M7 3v6m10-6v6' : i === 2 ? 'M12 2v13m-5-5 5 5 5-5M3 15v6h18v-6' : 'M12 16V3m-5 5 5-5 5 5M3 15v6h18v-6'}/></svg><strong>{label}</strong>{value}</span>)}</div></div>
      </div>
    </div>
  </div>
</div>
<style>
  .dashboard { width:100%; height:100%; container-type:inline-size; overflow:hidden; background:white; }
  .dashboard-ui { font: 400 1cqw/1.35 Arial, sans-serif; color:#122d4f; text-align:left; }
  .brandbar { height:4.7em; background:#40b9e6; display:flex; align-items:center; padding-left:2.1em; }
  .brandbar img { width:4.8em; height:auto; mix-blend-mode:lighten; }
  .workspace { display:grid; grid-template-columns:22% 1fr; }
  .sidebar { padding:0 1.35em 0 1.65em; }
  .sidebar div { display:flex; align-items:center; gap:.9em; height:3.4em; font-size:1.21em; white-space:nowrap; }
  .sidebar div:first-child { height:4.6em; border-bottom:1px solid #e0e5ea; margin-bottom:1em; color:#112b4c; font-weight:bold; }
  .sidebar svg { width:1em; height:1em; }
  .panels { display:grid; grid-template-columns:1.12fr 1fr; grid-template-rows:16.2em 16.2em auto; gap:1.4em; padding:2.6em 2em; background:#fafbfc; }
  .panel { min-width:0; padding:2.1em; border-radius:.85em; background:white; box-shadow:0 .35em 1.2em #1f345311; }
  .panel b { font-size:1.68em; letter-spacing:-.03em; }
  .usage { grid-row:span 2; display:flex; flex-direction:column; }
  .bars { display:flex; align-items:flex-end; justify-content:space-between; height:12em; margin:2.3em 0 2em; }
  .bars span { display:flex; align-items:flex-end; gap:.32em; height:100%; }
  .bars i { width:.86em; border-radius:.35em .35em 0 0; background:#239a90; }
  .bars i + i { background:#40bde4; }
  .stats { display:grid; grid-template-columns:1fr 1fr; gap:1em 0; font-size:1.25em; }
  .stats span:nth-child(even) { text-align:right; }
  .panel strong, .panel small { display:block; }
  .stats span:first-child strong { color:#06786f; }
  .stats span:nth-child(2) strong, .remaining > strong { color:#0879be; }
  .days, .status > div { display:flex; align-items:center; justify-content:space-between; }
  .days span { font-size:1.3em; }
  .days i { display:grid; place-items:center; width:3.45em; aspect-ratio:1; border-radius:50%; background:radial-gradient(closest-side,#fff 81%,transparent 84%),conic-gradient(#39b8e5 40%,#ddf3fa 0); font-size:2em; font-weight:bold; font-style:normal; }
  .remaining > strong { text-transform:uppercase; font-size:1.15em; }
  .status { display:flex; flex-direction:column; justify-content:space-between; }
  .status > div { font-size:1.38em; }
  .online { display:grid; justify-items:end; color:#52627b; font-size:.83em; }
  .online i { width:3.5em; height:1.7em; background:#3db9e7; border-radius:2em; position:relative; }
  .online i::after { content:''; width:1.22em; height:1.22em; position:absolute; right:.26em; top:.24em; background:white; border-radius:50%; }
  .subscription { grid-column:span 2; }
  .subscription > div { display:grid; grid-template-columns:repeat(4,1fr); gap:.9em; margin-top:1.25em; }
  .subscription span { display:grid; align-content:center; gap:.16em; padding:1.2em; background:#f4f5fb; border-radius:.45em; font-size:1.1em; }
  .subscription span:nth-child(2) { background:#fcf5f5; }
  .subscription span:nth-child(3) { background:#f0f8f6; }
  .subscription span:nth-child(4) { background:#f0f5fb; }
  .subscription svg { width:1.55em; height:1.55em; margin-bottom:.3em; }
</style>
