---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import PageIntro from './PageIntro.astro';
import { Image } from 'astro:assets';
import { projectImages } from '../data/project-images';
import { projects } from '../data/agency';
const { service } = Astro.props;
const project = projects.find(item => item.slug === service.project)!;
---
<AgencyLayout title={`${service.name} — Design & Development by Expresiv`} description={service.description}>
  <PageIntro section="All expertise" href="/services" lead={service.name.split(' ').slice(0,-1).join(' ')} accent={service.name.split(' ').at(-1) + '.'} summary={service.description}/>
  <section class="tint"><div class="wrap editorial-split">
    <div><p class="overline"><span class="index-mark" aria-hidden="true"></span>Scope</p><h2>What’s <em>involved.</em></h2></div>
    <ul class="scope-list">{service.deliverables.map((item: string) => <li>{item}</li>)}</ul>
  </div></section>
  <section class="wrap editorial-split">
    <div><h2>Before we <em>build.</em></h2></div>
    <ul class="question-rows">{service.questions.map((item: string) => <li>{item}</li>)}</ul>
  </section>
  <div class="tint"><section class="wrap related-project"><a href={`/works/${project.slug}`} aria-label={`View ${project.name} project`} style={`--plate:${project.color}`}><Image src={projectImages[project.image]} alt={project.alt} widths={[394,800]} sizes="(max-width: 680px) 90vw, 42vw" format="webp" loading="lazy"/></a><div><p class="overline">Related work</p><h2>{project.name}</h2><p>{project.summary}</p><a class="underlink" href={`/works/${project.slug}`}>Read the case study</a></div></section></div>
</AgencyLayout>
