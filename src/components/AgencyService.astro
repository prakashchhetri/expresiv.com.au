---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import {projects} from '../data/agency';
const {service} = Astro.props;
const project = projects.find(item => item.slug === service.project)!;
---
<AgencyLayout title={`${service.name} — Design & Development by Expresiv`} description={service.description}>
 <section class="page-hero wrap"><a href="/services" class="breadcrumb">← <span>All expertise</span></a><h1>{service.name}<br/><em>with intent.</em></h1><div class="page-intro"><span class="eyebrow">E—{service.number} / {service.phrase}</span><p>{service.description}</p></div></section>
 <section class="service-detail wrap" data-reveal><h2>What we can<br/><em>build together.</em></h2><ul class="deliverables">{service.deliverables.map((item:string,i:number)=><li><span>0{i+1}</span>{item}</li>)}</ul></section>
 <section class="service-detail wrap" data-reveal><h2>It starts with<br/><em>better questions.</em></h2><ol class="question-list">{service.questions.map((item:string)=><li>{item}</li>)}</ol></section>
 <section class="related-work wrap"><span class="eyebrow">A related project</span><div class="section-heading"><h2>{project.name}</h2><p>{project.summary}</p></div><a href={`/works/${project.slug}`} class="text-link">Explore the project <span aria-hidden="true">↗</span></a></section>
</AgencyLayout>
