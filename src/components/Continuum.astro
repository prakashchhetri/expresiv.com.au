<figure class="artboard" aria-label="Continuum, an interactive sculpture by Expresiv">
  <div class="art-field" data-sculpture>
    <img class="art-poster" src="/images/continuum.webp" alt="A coral-red sculpture made of thin discs twisting into a continuous knot" width="1080" height="1080" fetchpriority="high" draggable="false" />
    <canvas aria-hidden="true"></canvas>
  </div>
  <figcaption>
    <span class="art-title"><span class="study-mark" aria-hidden="true"></span>Continuum <i>/</i> <span data-sculpture-hint>Form study</span></span>
    <button type="button" class="turn-control" hidden>
      <span class="motion-symbol" aria-hidden="true"></span><span data-motion-label>Pause rotation</span>
    </button>
  </figcaption>
</figure>
<script>
  const field = document.querySelector<HTMLElement>('[data-sculpture]')!;
  const button = document.querySelector<HTMLButtonElement>('.turn-control')!;
  if ('WebGL2RenderingContext' in window) {
    const load = async () => {
      try {
        const { mountContinuum } = await import('../scripts/continuum.js');
        mountContinuum(field, button);
      } catch {
        button.hidden = true;
        delete field.dataset.live;
      }
    };
    const observer = new IntersectionObserver(entries => {
      if (entries.some(entry => entry.isIntersecting)) {
        observer.disconnect();
        void load();
      }
    });
    observer.observe(field);
  }
</script>
