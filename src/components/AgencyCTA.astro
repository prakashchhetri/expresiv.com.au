---
import Glyph from './Glyph.astro';
---
<section class="contact-section">
 <div class="contact-geo" aria-hidden="true"><Glyph kind="ring"/><Glyph kind="circle"/><Glyph kind="square"/></div>
 <div class="wrap">
  <div class="rule-row" style="border-color:#3a352a"><span class="eyebrow">A new chapter starts here</span><span class="eyebrow">Bring your idea. We’ll bring our perspective.</span></div>
  <a href="/contact" class="contact-title">Let’s make<br/><em>something.</em><span aria-hidden="true">↗</span></a>
  <div class="contact-bottom">
   <p>A website. An app. A smarter way of working.</p>
   <a class="pill" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
  </div>
 </div>
</section>
