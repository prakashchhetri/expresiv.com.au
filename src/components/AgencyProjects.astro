---
import {Image} from 'astro:assets';
import {projectImages} from '../data/project-images';
import { projects } from '../data/agency';
const { limit = projects.length } = Astro.props;
---
<div class="projects">
 {projects.slice(0,limit).map(project => <article class="project" data-category={project.type}>
  <a href={`/works/${project.slug}`} class:list={['project-image', { 'project-device': project.image === 'webnetwork' }]} style={`--project-color:${project.color}`} data-cursor="View" aria-label={`View ${project.name} project`}>
   <span class="project-type">E—{project.number} / {project.category}</span>
   <Image src={projectImages[project.image]} alt={project.alt} widths={project.image === 'webnetwork' ? [640,1200,1800] : [480,800]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={85} loading="lazy" decoding="async"/>
   <span class="project-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-caption"><h3 data-split><a href={`/works/${project.slug}`}>{project.name}</a></h3><span>{project.category}</span></div>
  <p class="project-summary" data-reveal>{project.summary}</p>
 </article>)}
</div>
