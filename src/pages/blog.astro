---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { getBlogPosts, plainText } from '../lib/posts';
let feedAvailable = true;
const posts = await getBlogPosts().catch(() => { feedAvailable = false; return []; });
---
<AgencyLayout title="Studio Journal — Expresiv" description="Articles from the Expresiv studio on digital product design, development, and building for the people who use your software.">
  <PageIntro section="Insights" lead="Studio" accent="journal." summary="Notes on designing, developing and looking after digital products."/>
  <section class="resource-section tint"><div class="wrap">
    {!feedAvailable && <p class="feed-status">The latest articles are temporarily unavailable.</p>}
    <div class="resource-grid">
      {posts.map(post => <article class="resource-card"><p class="meta">{new Date(post.date).toLocaleDateString('en-AU', {dateStyle:'long'})}</p><h2><a href={`/blog/${post.slug}`}>{plainText(post.title.rendered)}</a></h2><p>{plainText(post.excerpt?.rendered || '').slice(0,220)}</p><a class="underlink" href={`/blog/${post.slug}`}>Read article</a></article>)}
      <article class="resource-card"><p class="meta">Product design</p><h2><a href="/single-page">Testing a prototype before development</a></h2><p>Choose one task, observe someone using the prototype and use what you learn in the next build.</p><a class="underlink" href="/single-page">Read the studio note</a></article>
    </div>
  </div></section>
  <section class="wrap related-strip"><div><p class="overline">Website tools</p><h2>Check a <em>website.</em></h2></div><div class="resource-links"><a class="underlink" href="/seo-audit">SEO audit</a><a class="underlink" href="/competitor-analysis">Competitor analysis</a></div></section>
</AgencyLayout>
