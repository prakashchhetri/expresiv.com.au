---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import AgencyProjects from '../components/AgencyProjects.astro';
export const prerender = true;
---
<AgencyLayout title="Selected Work — Expresiv" description="Explore Expresiv’s Web Networks customer platform, OffshoreGeniX website and Beauty & Nails visual direction.">
 <section class="wrap page-hero"><span class="eyebrow">01 / Selected work</span><h1>Ideas out<br/><em>in the world.</em></h1><div class="page-intro"><span class="eyebrow">Selected projects / 01—03</span><p>Different businesses. Different needs. A collection of digital experiences and visual directions, each with its own point of view.</p></div></section>
 <section class="wrap portfolio" aria-label="Project portfolio"><div class="work-filters" role="group" aria-label="Filter projects" hidden><button data-filter="all" aria-pressed="true">All work <span>03</span></button><button data-filter="websites" aria-pressed="false">Websites</button><button data-filter="platforms" aria-pressed="false">Platforms & apps</button><button data-filter="identity" aria-pressed="false">Visual direction</button></div><p class="sr-only" role="status" data-filter-status>3 projects shown</p><h2 class="sr-only">Projects</h2><AgencyProjects/></section>
</AgencyLayout>
