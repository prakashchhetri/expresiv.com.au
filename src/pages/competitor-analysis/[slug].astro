---
import AgencyLayout from '../../layouts/AgencyLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {config} from '../../lib/api-config';
const {slug} = Astro.params;
let report;
let missing = false;
try {
  const response = await fetch(config.endpoints.competitorAnalysisPage(encodeURIComponent(slug || '')), {signal: AbortSignal.timeout(5000)});
  missing = response.status === 404;
  if (response.ok) report = await response.json();
} catch { /* Render the temporary-unavailability state. */ }
if (missing) return Astro.rewrite('/404');
if (!report) Astro.response.status = 503;
const {page_title, page_description, business_type, location, created_at} = report || {};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": page_title || "Competitor Analysis",
  "description": page_description || "Comprehensive competitor analysis and market insights",
  "author": {
    "@type": "Organization",
    "name": "Expresiv",
    "url": "https://expresiv.com.au"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Expresiv",
    "url": "https://expresiv.com.au"
  },
  "datePublished": created_at || new Date().toISOString(),
  "dateModified": created_at || new Date().toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://expresiv.com.au/competitor-analysis/${slug}/`
  },
  "about": {
    "@type": "Thing",
    "name": business_type || "business analysis",
    "description": `Competitor analysis for ${business_type || 'businesses'} in ${location || 'the market'}`
  }
};
const schemaJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const webLink = (url: string) => /^https?:\/\//i.test(url);
---
<AgencyLayout title={`${page_title || 'Search report'} — Expresiv`} description={page_description || 'Read this search visibility and competitor analysis report from the Expresiv library.'}>
  {report && <script type="application/ld+json" set:html={schemaJson}/>}
  <PageIntro section="Competitor library" href="/competitor-analysis-pages" lead={page_title || 'Report temporarily unavailable'} summary={page_description}/>
  {report ? <article class="article-body wrap">
    <p class="meta">{[report.domain, location, business_type].filter(Boolean).join(' / ')}</p>
    <p>{report.content_intro}</p>
    <h2>Keywords analysed</h2><p>{report.keywords_analyzed?.join(', ') || 'No keywords recorded.'}</p>
    <h2>Top competitors</h2>
    {report.competitors?.map(item => <section class="resource-card"><h3>{item.title || item.domain}</h3><p>{item.domain} · Visibility score {item.visibility_score}</p><p>{item.snippet}</p>{webLink(item.competitor_url) && <a class="underlink" href={item.competitor_url}>Visit website</a>}</section>)}
    {report.content_conclusion && <><h2>Findings</h2><p>{report.content_conclusion}</p></>}
    <p><a href="/competitor-analysis">Run a competitor analysis</a> · <a href="/seo-audit">Run an SEO audit</a></p>
  </article> : <div class="article-body wrap"><p>Try again later or <a href="/competitor-analysis-pages">browse the library</a>.</p></div>}
</AgencyLayout>
