---
import AgencyCaseStudy from '../../components/AgencyCaseStudy.astro';
import {projects} from '../../data/agency';
export const prerender = true;
export function getStaticPaths() {
 return projects.filter(project => project.slug !== 'web-networks').map(project => ({params:{slug:project.slug},props:{project}}));
}
const {project} = Astro.props;
---
<AgencyCaseStudy project={project}/>
