---
import AgencyLayout from '../../layouts/AgencyLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import services from '../../data/services.json';

export const prerender = true;
export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const descriptions: Record<string, string> = {
  'ai-solutions': 'AI assistants and automation',
  'ui-ux': 'Interface and experience design',
  'dental-clinic-design': 'Dental clinic websites',
  'cleaning-company-website-design': 'Cleaning company websites',
  'sydney-based-website': 'Sydney website design',
  'ecommerce-website-design': 'E-commerce websites'
};
const name = descriptions[service.slug] || service.title;
---
<AgencyLayout title={`${name} — Expresiv`} description={service.metaDescription || service.description}>
  <PageIntro section="All expertise" href="/services" lead={name} summary={service.description}/>
  <section class="tint resource-section"><div class="wrap">
    <h2 class="resource-title">What we can <em>deliver.</em></h2>
    <div class="resource-grid">{service.services.map(item => <article class="resource-card"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  </div></section>
  {service.features?.length > 0 && <section class="editorial-split wrap"><h2>Working with <em>your team.</em></h2><div class="copy-rows">{service.features.map(item => <article>{item.title && <h3>{item.title}</h3>}<p>{item.description}</p></article>)}</div></section>}
  {service.typesOfWebsites && <section class="resource-section wrap"><h2 class="resource-title">Website types</h2><div class="resource-grid">{service.typesOfWebsites.map(item => <article class="resource-card"><h3>{item.title}</h3><p>{item.description}</p><a class="underlink" href={item.link}>Explore {item.title}</a></article>)}</div></section>}
</AgencyLayout>
