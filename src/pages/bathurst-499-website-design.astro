---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import PageIntro from '../components/PageIntro.astro';
export const prerender = true;
const inclusions = [
  "Custom homepage plus up to 3 supporting pages (e.g. About, Services, Contact).",
  "Conversion-focused copy guidance to clearly explain what you do.",
  "Responsive design matched to your brand colours and imagery.",
  "On-page SEO best practices for \"Bathurst\" and your core services.",
  "Contact form integrated to your email so enquiries go straight to you.",
  "Basic analytics and call-to-action buttons wired for phone and email.",
];
---
<AgencyLayout title="$499 Website Design for Bathurst Businesses — Expresiv" description="A fixed-scope WordPress website for Bathurst businesses. See the $499 package inclusions, typical timing and how to enquire.">
  <PageIntro section="Bathurst studio" href="/bathurst" lead="A local website" accent="for $499." summary="A WordPress site for a Bathurst business with a clear offer and a handful of pages. Your team can update the content after launch.">
    <div class="intro-actions"><a class="solid-button" href="/contact">Enquire about the package</a><a class="underlink" href="tel:+61433951797">0433 951 797</a></div>
  </PageIntro>
  <div class="tint"><section class="editorial-split wrap"><h2>Inside the <em>package.</em></h2><ul class="scope-list">{inclusions.map(item => <li>{item}</li>)}</ul></section></div>
  <section class="editorial-split wrap"><h2>Getting <em>started.</em></h2><div class="copy-rows">
    <article><h3>Tell us about the business</h3><p>Include your suburb, the services you offer and a link to your current site if you have one. We’ll confirm the scope and quote any extras separately.</p></article>
    <article><h3>Prepare your content</h3><p>Share your logo, photos, contact details and the text you want to publish. A typical build takes 10–15 business days once the content is ready.</p></article>
    <article><h3>Review and launch</h3><p>Review the pages before they go live on your domain. We can help arrange domain and hosting and show you how to make updates in WordPress.</p></article>
    <article><h3>Need booking or online sales?</h3><p>Extra pages, bookings and e-commerce can be scoped as additions or as a separate custom project.</p></article>
  </div></section>
</AgencyLayout>
