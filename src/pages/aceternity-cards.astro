---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import CardStack from '../components/ui/CardStack';
const items = [
  {id:1,name:'Discovery',designation:'Studio process',content:'Map the people, tasks and systems the product needs to support.'},
  {id:2,name:'Prototype',designation:'Studio process',content:'Try a working version with someone who will use the product.'},
  {id:3,name:'Delivery',designation:'Studio process',content:'Test the release and hand over the accounts, code and documentation.'}
];
---
<Layout title="Card Stack — Expresiv Studio Study"><PageIntro section="Interaction study" lead="Card" accent="stack." summary="An experiment in how depth and motion can sequence a set of cards."/><div class="demo-stage tint"><CardStack client:visible items={items}/></div></Layout>
