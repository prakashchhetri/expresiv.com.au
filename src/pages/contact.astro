---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
export const prerender = true;
---
<AgencyLayout title="Start a Project — Expresiv" description="Talk to Expresiv about your software, mobile app or website project. Contact our independent Australian design and development studio." showCTA={false}>
  <section class="wrap contact-spread">
    <div class="profile-copy"><p class="overline"><span class="spark" aria-hidden="true">✳</span>Project enquiries</p>
      <h1>What are you<br/><em>working on?</em></h1>
      <p>Tell us who it’s for, what it needs to do and any timing you have in mind. We’ll come back to you within two working days.</p>
      <a class="underlink" href="mailto:info@expresiv.com.au">info@expresiv.com.au</a>
      <p class="meta contact-location">Bathurst, NSW · Working Australia-wide</p>
    </div>
    <div class="enquiry contact-panel"><h2>Your project</h2><EnquiryForm home/></div>
  </section>
</AgencyLayout>
