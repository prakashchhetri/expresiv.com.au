---
import AgencyLayout from '../layouts/AgencyLayout.astro';
export const prerender = true;
---
<AgencyLayout title="Start a Project — Expresiv" description="Tell Expresiv about your website, mobile app or software project. Contact our independent Australian design and development studio." showCTA={false}>
 <section class="wrap page-hero"><span class="eyebrow">04 / Start a conversation</span><h1>Every idea starts<br/><em>somewhere.</em></h1></section>
 <section class="wrap contact-grid">
  <div class="contact-aside"><h2>You bring the idea.<br/><em>We’ll ask the questions.</em></h2><p>Tell us what you have in mind. An early idea, a clear brief or a challenge to solve — we’d love to hear it.</p><a class="text-link" href="mailto:info@expresiv.com.au">info@expresiv.com.au ↗</a><span class="eyebrow">Australia · Working everywhere</span></div>
  <form id="contact-form" action="/api/contact" method="post">
   <label for="name">Your name<input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Alex Smith"/></label>
   <label for="email">Email address<input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="alex@company.com"/></label>
   <label for="message">What are you thinking?<textarea id="message" name="message" rows="5" required maxlength="10000" placeholder="Tell us about your project, your goals and any timing you have in mind."></textarea></label>
   <p class="form-note">Your details will be used to respond to this enquiry.</p>
   <button type="submit" class="pill">Send enquiry <span aria-hidden="true">↗</span></button>
   <p id="form-status" role="status" aria-live="polite"></p>
  </form>
 </section>
</AgencyLayout>
<script>
 import {sendEnquiry} from '../lib/enquiry.mjs';
 function initContactForm() {
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (!form || form.dataset.initialized) return;
  form.dataset.initialized = 'true';
  form.addEventListener('submit', async (event) => {
   event.preventDefault();
   const button = form.querySelector<HTMLButtonElement>('button')!;
   const status = form.querySelector<HTMLParagraphElement>('#form-status')!;
   button.disabled = true;
   form.setAttribute('aria-busy', 'true');
   status.textContent = 'Sending your enquiry…';
   try {
    const body = new URLSearchParams();
    new FormData(form).forEach((value, key) => body.append(key, String(value)));
    status.textContent = await sendEnquiry(body);
    form.reset();
   } catch {
    status.textContent = 'Your enquiry could not be sent. Please try again or email info@expresiv.com.au.';
   } finally {
    button.disabled = false;
    form.removeAttribute('aria-busy');
   }
  });
 }
 initContactForm();
 document.addEventListener('astro:page-load', initContactForm);
</script>
