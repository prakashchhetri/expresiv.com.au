---
import AgencyLayout from '../../layouts/AgencyLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import {getBlogPosts, plainText} from '../../lib/posts';
let unavailable = false;
const [post] = await getBlogPosts(Astro.params.slug).catch(() => { unavailable = true; return []; });
if (!unavailable && !post) return Astro.rewrite('/404');
if (unavailable) Astro.response.status = 503;
const title = post ? plainText(post.title.rendered) : 'Article temporarily unavailable';
const image = post?._embedded?.['wp:featuredmedia']?.[0];
---
<AgencyLayout title={`${title} — Expresiv Journal`} description={plainText(post?.excerpt?.rendered || 'Read design and development notes from the Expresiv studio.').slice(0,175)}>
  <PageIntro section="Studio journal" href="/blog" lead={title}/>
  {post ? <article class="article-body wrap">
    <p class="meta">{new Date(post.date).toLocaleDateString('en-AU', {dateStyle:'long'})}</p>
    {image && <img src={image.source_url} alt={image.alt_text || ''}/>}
    <div set:html={post.content?.rendered || ''}></div>
  </article> : <div class="article-body wrap"><p>The journal feed could not be reached. You can try again or <a href="/blog">return to the journal</a>.</p></div>}
</AgencyLayout>
