---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import {config} from '../lib/api-config';
let available = true;
let pages = [];
try {
  const response = await fetch(config.endpoints.competitorAnalysisPages, {signal: AbortSignal.timeout(5000)});
  if (!response.ok) throw new Error();
  pages = (await response.json()).pages || [];
} catch { available = false; }
---
<AgencyLayout title="Competitor Analysis Library — Expresiv" description="Browse published search competitor reports by business and location, or start a new analysis with Expresiv.">
  <PageIntro section="Search tools" lead="Competitor" accent="library." summary="Published search reports by business, market and location."><a class="solid-button" href="/competitor-analysis">Start an analysis</a></PageIntro>
  <section class="tint resource-section"><div class="wrap">{pages.length ? <div class="resource-grid">{pages.map(page => <article class="resource-card"><p class="meta">{page.location || page.domain}</p><h2><a href={`/competitor-analysis/${page.slug}`}>{page.title}</a></h2><p>{page.domain} · {page.business_type}</p><a class="underlink" href={`/competitor-analysis/${page.slug}`}>Read report</a></article>)}</div> : <p>{available ? 'There are no published reports yet.' : 'The report library is temporarily unavailable.'}</p>}</div></section>
</AgencyLayout>
