---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import AgencyProjects from '../components/AgencyProjects.astro';
import {services} from '../data/agency';
export const prerender = true;
---
<AgencyLayout title="Expresiv — Ideas, fully expressed." description="Independent Australian design and development studio. We turn ideas into expressive websites, useful mobile apps and custom software. See our work.">
 <section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-meta"><span class="eyebrow"><i></i>Independent design & development</span><span class="eyebrow">Australia / Open to possibility</span></div>
  <div class="hero-intro"><p class="hero-kicker">A little imagination.<br/>A lot of intention.</p><p>We give ambitious ideas a digital life.<br/> Websites, mobile apps and software.<br/> Considered from the inside out.</p></div>
  <h1 id="hero-title"><span class="hero-line">Ideas, fully</span><span class="expression-frame"><span class="expression-word">expressed<span class="expression-period">.</span></span></span></h1>
  <div class="hero-bottom"><span class="eyebrow">The space between thinking and making.</span><a href="/work" class="text-link">Explore our work <span aria-hidden="true">↓</span></a></div>
 </section>
 <section class="wrap home-work"><div class="section-top"><span class="eyebrow">01 / Ideas in the world</span><a href="/work" class="text-link">All projects <span aria-hidden="true">↗</span></a></div><div class="section-heading" data-reveal><h2>Different challenges.<br/><em>One considered approach.</em></h2><p>A clearer connection. A stronger presence.<br/>Work shaped around what matters.</p></div><AgencyProjects limit={2}/></section>
 <section class="expertise"><div class="wrap"><div class="section-top"><span class="eyebrow">02 / What we bring</span><span class="eyebrow">Thinking + making</span></div><div class="expertise-intro" data-reveal><h2>Good on the outside.<br/><em>Great on the inside.</em></h2><p>We connect the story people see with the technology they use. From the first sketch to the final interaction.</p></div>{services.map(service => <a class="service" href={`/services/${service.slug}`}><span class="service-number">{service.number}</span><h3>{service.name}</h3><p>{service.short}</p><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div></section>
 <section class="studio-teaser wrap" data-reveal><span class="eyebrow">03 / A studio with a point of view</span><div><h2>Small enough to care.<br/><em>Curious enough to question.</em></h2><p>We look for the idea inside the brief. Then we design it, build it and work through the details that make it feel right.</p><a href="/studio" class="text-link">Get to know Expresiv <span aria-hidden="true">↗</span></a></div></section>
</AgencyLayout>
