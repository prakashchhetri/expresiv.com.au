---
import AgencyLayout from '../layouts/AgencyLayout.astro';
import Glyph from '../components/Glyph.astro';
import {Image} from 'astro:assets';
import {projectImages} from '../data/project-images';
import {projects, services} from '../data/agency';
export const prerender = true;
const serviceShapes = ['circle','half','square'];
const marquee = ['Websites','Mobile apps','Custom software','AI automation','Business systems','Digital marketing'];
const featured = projects.slice(0, 2);
---
<AgencyLayout title="Expresiv — Ideas, fully expressed." description="Independent Australian design and development studio in Bathurst NSW. Websites, mobile apps, custom software and AI automation, designed and built with intent.">
 <section class="hero" aria-labelledby="hero-title">
  <div class="hero-field" aria-hidden="true"></div>
  <div class="hero-noise" aria-hidden="true"></div>
  <div class="hero-meta">
   <span class="eyebrow"><i></i>Independent design &amp; development studio</span>
   <span class="eyebrow">Bathurst NSW — Working Australia-wide</span>
  </div>
  <div class="hero-masthead">
   <h1 id="hero-title" data-split>
    <span class="hero-line">Ideas, fully</span>
    <span class="hero-line"><span data-word><span class="expression-word">expressed</span><span class="expression-period">.</span></span></span>
   </h1>
  </div>
  <div class="hero-bottom">
   <p data-reveal>We give ambitious ideas a digital life. Websites, apps, software and automation — considered from the inside out.</p>
   <div class="scroll-cue" aria-hidden="true"><span>Scroll</span><i></i></div>
   <div class="hero-right" data-reveal>
    <span class="eyebrow"><i></i>Available for new projects</span>
    <a href="/work" class="text-link">Selected work <span aria-hidden="true">↓</span></a>
   </div>
  </div>
 </section>

 <div class="marquee" aria-hidden="true">
  <div class="marquee-track">{[0,1,2,3].map(() => marquee.map(item => <span>{item}</span>))}</div>
 </div>

 <section class="work-index" aria-labelledby="work-title">
  <div class="work-head">
   <div><span class="eyebrow"><span class="fig" data-shape="circle">01</span> Selected work</span><h2 id="work-title" data-split>Different challenges.<br/><em>One considered approach.</em></h2></div>
   <p data-reveal>A clearer connection. A stronger presence. Work shaped around what actually matters to the person on the other side of the screen.</p>
  </div>
  {featured.map((project, i) => <article class="plate">
   <a class:list={['plate-media', {device: project.image === 'webnetwork'}]} href={`/works/${project.slug}`} style={`--plate-color:${project.color}`} data-cursor="View" aria-label={`View ${project.name}`}>
    <span class="plate-no" aria-hidden="true">{project.number}</span>
    <Image src={projectImages[project.image]} alt={project.alt} widths={project.image === 'webnetwork' ? [640,1200,1800] : [480,800]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={85} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" data-parallax="30"/>
   </a>
   <div class="plate-body">
    <div class="plate-cat"><span class="eyebrow">E—{project.number} / {project.category}</span><div class="plate-tags">{project.scope.map(s => <span>{s}</span>)}</div></div>
    <div><h3 data-split>{project.headline}</h3><p data-reveal>{project.summary}</p></div>
    <div class="plate-foot"><span class="eyebrow">{project.name}</span><a href={`/works/${project.slug}`} class="pill">Read the story <span aria-hidden="true">↗</span></a></div>
   </div>
  </article>)}
  <div class="work-more"><a href="/work" class="pill pill-ghost">All projects <span aria-hidden="true">↗</span></a></div>
 </section>

 <section class="expertise" aria-labelledby="expertise-title">
  <div class="expertise-pin">
   <span class="eyebrow"><span class="fig" data-shape="square">02</span> What we bring</span>
   <h2 id="expertise-title" data-split>Good on the outside.<br/><em>Great on the inside.</em></h2>
   <p data-reveal>We connect the story people see with the technology they use — from the first sketch to the final interaction.</p>
  </div>
  <div>
   {services.map((service, i) => <a class="service" href={`/services/${service.slug}`}>
    <span class="service-number"><Glyph kind={serviceShapes[i]}/>{service.number}</span>
    <h3 data-split>{service.name}</h3>
    <p>{service.short}</p>
    <span class="service-arrow" aria-hidden="true">↗</span>
   </a>)}
  </div>
 </section>

 <section class="manifesto panel-bone" aria-labelledby="manifesto-title">
  <div class="manifesto-aside">
   <span class="eyebrow"><span class="fig" data-shape="triangle">03</span> A point of view</span>
   <div class="shape-stack" aria-hidden="true"><Glyph kind="circle"/><Glyph kind="half"/><Glyph kind="frame"/></div>
  </div>
  <div>
   <p id="manifesto-title" class="statement" data-split>Small enough to care. Curious enough to question. We look for the idea inside the brief, then design it, build it and work through the details that <em>make it feel right.</em></p>
   <a href="/studio" class="text-link">Get to know the studio <span aria-hidden="true">↗</span></a>
  </div>
 </section>

 <section class="numbers panel-bone" aria-label="Studio at a glance">
  <div data-reveal><strong>48<small>hr</small></strong><span>Every enquiry answered by a person, not a queue</span></div>
  <div data-reveal><strong>10<small>days</small></strong><span>Typical first launch for a local business site</span></div>
  <div data-reveal><strong>1<small>:1</small></strong><span>You deal with whoever designs and builds it</span></div>
  <div data-reveal><strong>0</strong><span>Lock-in. Your accounts, code and data stay yours</span></div>
 </section>
</AgencyLayout>
