---
import PageIntro from '../components/PageIntro.astro';
import Layout from "../layouts/Layout.astro";
import WavyBackground from "../components/ui/WavyBackground.tsx";
import Sparkles from "../components/ui/Sparkles.tsx";
---

<Layout title="Wave Field — Expresiv Studio Study">
  <PageIntro section="Motion study" lead="Wave" accent="field."/>
  <div class="demo-stage tint">
    <section
      class="relative rounded-full overflow-hidden bg-stone-900"
      style="width: min(90vw, 90vh); height: min(90vw, 90vh);"
    >
      <WavyBackground
        client:load
        containerClassName="h-full w-full"
        className="h-full w-full"
        backgroundFill="transparent"
        colors={["#e84c2d", "#e9704b", "#f7b393", "#b74534", "#e4cbbb"]}
        waveWidth={60}
        blur={8}
        speed="fast"
        waveOpacity={0.5}
      >
        <Sparkles
          client:load
          className="mix-blend-screen"
          particleColor="rgba(255,255,255,0.9)"
          particleDensity={12}
          minSize={0.6}
          maxSize={2.4}
          speed={24}
        />
      </WavyBackground>
    </section>
  </div>
</Layout>


