---
import AgencyLayout from '../layouts/AgencyLayout.astro';
export const prerender = true;
---
<AgencyLayout title="The Studio — Expresiv" description="Get to know Expresiv, an independent design and software development studio based in Bathurst and working with businesses across Australia.">
  <section class="wrap studio-profile">
    <div class="profile-copy">
      <p class="overline"><span class="spark" aria-hidden="true">✳</span>The studio</p>
      <h1>Design and code,<br/><em>at one table.</em></h1>
      <p>Expresiv is an independent studio in Bathurst, NSW. We work with Australian businesses on the software their customers and teams use every day.</p>
      <a class="underlink" href="/work">Explore our work</a>
    </div>
    <figure class="studio-print"><div><img src="/images/continuum.webp" width="1080" height="1080" alt="Close-up of the ridges and folds in Expresiv’s Continuum sculpture"/></div><figcaption class="meta">Continuum <i>/</i> Detail from the studio’s interactive form study</figcaption></figure>
  </section>
  <div class="tint"><section class="editorial-split wrap">
    <div><p class="overline"><span class="index-mark" aria-hidden="true"></span>Our approach</p><h2>Inside the <em>studio.</em></h2></div>
    <div class="copy-rows">
      <article><h3>Understand the everyday work</h3><p>How does a customer pay a bill? Where does a job sheet go next? Those details tell us what the product needs to do.</p></article>
      <article><h3>Work directly with the makers</h3><p>You speak with the people who design and build the product. A question about the interface and a question about the database can be part of the same conversation.</p></article>
      <article><h3>Leave room for what comes next</h3><p>We consider who will update the content, manage the accounts and make changes after launch. Handover is part of the build.</p></article>
    </div>
  </section></div>
  <section class="wrap related-strip"><div><p class="overline">Bathurst, NSW</p><h2>Working in the <em>Central West.</em></h2></div><a class="underlink" href="/bathurst">Our Bathurst studio</a></section>
</AgencyLayout>
